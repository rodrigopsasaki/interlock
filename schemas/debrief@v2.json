{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/debrief@v2.json",
  "title": "debrief@v2",
  "description": "A debrief.yaml file at the current shape: the first version whose items are checked in full, and the first to hard-require a because on every decision. drafted is a presence marker, not a kind: a debrief is drafted the moment it is set.",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "debrief@v2"
    },
    "graph": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "graph_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "session_start_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "derivation": {
      "$ref": "parts/debrief-derivation.json"
    },
    "discoveries": {
      "type": "array",
      "items": {
        "$ref": "parts/discovery.json"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "parts/decision.json"
      }
    },
    "gates_run_by_agent": {
      "type": "array",
      "items": {
        "$ref": "parts/gate-run.json"
      }
    },
    "open": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drafted": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "from"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "interlock",
    "graph",
    "node",
    "role",
    "graph_base_sha",
    "session_start_sha",
    "head_sha",
    "derivation",
    "discoveries",
    "decisions",
    "gates_run_by_agent",
    "open"
  ],
  "additionalProperties": true
}
