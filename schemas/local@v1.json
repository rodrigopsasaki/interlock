{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/local@v1.json",
  "title": "local@v1",
  "description": "Optional provider_order breaks ledger ties and last_resort keeps one provider last (anthropic by default); neither overrides headroom among ordinary providers. Historical local@v0 reads unchanged.",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "local@v1"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startup_answers": {
          "type": "array",
          "items": {
            "$ref": "parts/startup-answer.json"
          }
        },
        "startup_timeout_ms": {
          "type": "number"
        },
        "prompt_taken_timeout_ms": {
          "type": "number"
        },
        "ready_settle_ms": {
          "type": "number"
        },
        "prompt_retries": {
          "type": "number"
        },
        "writable_root_args": {
          "$ref": "parts/writable-root-args.json"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "default_runtime": {
      "type": "string"
    },
    "worktree_root": {
      "type": "string"
    },
    "worktree_setup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lease_ms": {
      "type": "number"
    },
    "run_timeout_ms": {
      "type": "number"
    },
    "answer_grace_ms": {
      "type": "number"
    },
    "watch_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^/"
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "exclude": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
                }
              }
            },
            "required": [
              "path",
              "exclude"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "owner_login": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "substrate": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        },
        "send_repository": {
          "type": "boolean"
        }
      },
      "required": [
        "address"
      ],
      "additionalProperties": true
    },
    "provider_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "last_resort": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "interlock",
    "runtime",
    "worktree_root",
    "lease_ms",
    "run_timeout_ms",
    "substrate"
  ],
  "additionalProperties": true
}
