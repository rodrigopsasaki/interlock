{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/discovery.json",
  "title": "discovery",
  "description": "A discovery entry as debrief@v2 requires it in full: something the session found that its brief did not give it.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "what": { "type": "string" },
    "found_at": { "type": "string" },
    "mattered_because": { "type": "string" }
  },
  "required": ["id", "what", "found_at", "mattered_because"],
  "additionalProperties": false
}
