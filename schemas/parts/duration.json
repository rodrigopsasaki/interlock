{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/duration.json",
  "title": "duration",
  "description": "How long a receipt took to earn: measured, or unknown when a legacy receipt carried none.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": { "const": "measured" },
        "ms": { "type": "number" }
      },
      "required": ["kind", "ms"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "kind": { "const": "unknown" } },
      "required": ["kind"],
      "additionalProperties": false
    }
  ]
}
