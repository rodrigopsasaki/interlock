{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/node.json",
  "title": "node",
  "description": "A reference to one node of one graph, embedded wherever an event names the node it happened to.",
  "type": "object",
  "properties": {
    "graph": { "type": "string" },
    "id": { "type": "string" }
  },
  "required": ["graph", "id"],
  "additionalProperties": false
}
