{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/derivation.json",
  "title": "derivation",
  "description": "Who produced a receipt or a mark: a gate run, a model, or a person.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": { "const": "gate" },
        "gate": { "type": "string" },
        "version": { "type": "string" },
        "runner": { "type": "string" }
      },
      "required": ["kind", "gate", "version", "runner"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "model" },
        "model": { "type": "string" },
        "promptId": { "type": "string" },
        "lens": { "type": "string" }
      },
      "required": ["kind", "model", "promptId", "lens"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "human" },
        "who": { "type": "string" }
      },
      "required": ["kind", "who"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "human" },
        "who": { "type": "string" },
        "for": { "type": "string" },
        "cite": { "type": "string" },
        "citeKey": { "type": "string" },
        "author": { "type": "string" },
        "words": { "type": "string" },
        "at": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "reading": { "type": "string" },
        "action": { "enum": ["approve", "clear", "publish"] },
        "target": {
          "type": "object",
          "properties": {
            "graph": { "type": "string" },
            "node": { "type": "string" },
            "gate": { "type": "string" }
          },
          "required": ["graph"],
          "additionalProperties": false
        },
        "contentHash": { "type": "string" }
      },
      "required": [
        "kind",
        "who",
        "for",
        "cite",
        "citeKey",
        "author",
        "words",
        "at",
        "reading",
        "action",
        "target",
        "contentHash"
      ],
      "additionalProperties": false
    }
  ]
}
