{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/gate-run.json",
  "title": "gate-run",
  "description": "A gate run entry as debrief@v2 requires it in full: result is exactly pass or fail.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "result": { "enum": ["pass", "fail"] },
    "invocation": { "type": "string" },
    "note": { "type": "string" }
  },
  "required": ["id", "result"],
  "additionalProperties": false
}
