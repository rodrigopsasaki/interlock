{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/receipt.json",
  "title": "receipt",
  "description": "A fact the harness observed. Content-addressed by SHA and gate. Carries its spend and its derivation.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "gate": { "type": "string" },
    "commitSha": { "type": "string" },
    "spend": { "$ref": "spend.json" },
    "duration": { "$ref": "duration.json" },
    "derivation": { "$ref": "derivation.json" },
    "proof": { "type": "object" }
  },
  "required": [
    "id",
    "gate",
    "commitSha",
    "spend",
    "duration",
    "derivation",
    "proof"
  ],
  "additionalProperties": false
}
