{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/outcome-v1.json",
  "title": "outcome@v1",
  "description": "How a node ended, as event@v1 carried it: held always meant a failed gate, flat on the outcome; reset carried no authority or because.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": { "const": "cleared" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } }
      },
      "required": ["kind", "receipts"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "held" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } },
        "failure": { "type": "string" },
        "disposition": { "$ref": "disposition.json" },
        "because": { "type": "string" },
        "expiry": { "type": "number" }
      },
      "required": [
        "kind",
        "receipts",
        "failure",
        "disposition",
        "because",
        "expiry"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "reset" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } }
      },
      "required": ["kind", "receipts"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "failed" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } },
        "failure": { "type": "string" },
        "disposition": { "$ref": "disposition.json" },
        "because": { "type": "string" }
      },
      "required": ["kind", "receipts", "failure", "disposition", "because"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "cancelled" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } },
        "authority": { "type": "string" },
        "because": { "type": "string" }
      },
      "required": ["kind", "receipts", "authority", "because"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "superseded" },
        "receipts": { "type": "array", "items": { "$ref": "receipt-v1.json" } },
        "authority": { "type": "string" },
        "because": { "type": "string" }
      },
      "required": ["kind", "receipts", "authority", "because"],
      "additionalProperties": false
    }
  ]
}
