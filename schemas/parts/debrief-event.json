{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/parts/debrief-event.json",
  "title": "debrief-event",
  "description": "The ledger's own Debrief, embedded verbatim in a debrief-filed event. Field names are the in-memory camelCase names, not the snake_case keys a debrief.yaml file carries on disk; only the full, current shape is ever embedded, since event@v1 refuses debrief-filed outright.",
  "type": "object",
  "properties": {
    "graph": { "type": "string" },
    "node": { "type": "string" },
    "role": { "type": "string" },
    "graphBaseSha": { "type": "string" },
    "sessionStartSha": { "type": "string" },
    "headSha": { "type": "string" },
    "derivation": { "$ref": "debrief-derivation.json" },
    "discoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/discovery" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "gatesRunByAgent": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateRun" }
    },
    "open": { "type": "array", "items": { "type": "string" } },
    "drafted": { "$ref": "#/$defs/drafted" }
  },
  "required": [
    "graph",
    "node",
    "role",
    "graphBaseSha",
    "sessionStartSha",
    "headSha",
    "derivation",
    "discoveries",
    "decisions",
    "gatesRunByAgent",
    "open"
  ],
  "additionalProperties": false,
  "$defs": {
    "discovery": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "what": { "type": "string" },
        "foundAt": { "type": "string" },
        "matteredBecause": { "type": "string" }
      },
      "required": ["id", "what", "foundAt", "matteredBecause"],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "what": { "type": "string" },
        "because": { "type": "string" },
        "restsOn": { "type": "array", "items": { "type": "string" } },
        "hunks": { "type": "array", "items": { "type": "string" } },
        "produces": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "string" }
      },
      "required": ["id", "what", "because", "restsOn", "hunks"],
      "additionalProperties": false
    },
    "gateRun": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "result": { "enum": ["pass", "fail"] },
        "invocation": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "result"],
      "additionalProperties": false
    },
    "drafted": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "from": { "type": "string" }
      },
      "required": ["by", "from"],
      "additionalProperties": false
    }
  }
}
