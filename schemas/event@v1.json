{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/event@v1.json",
  "title": "event@v1",
  "description": "One line of the journal, at the shape event@v1 carried: no debrief-filed kind (v1 never recorded its fields), no session-narrated kind, a legacy receipt with no duration, and a legacy outcome whose held is always a gate failure and whose reset carries no authority or because.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "node-created" },
        "node": { "$ref": "parts/node.json" }
      },
      "required": ["interlock", "kind", "node"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "enum": ["lease-taken", "lease-renewed"] },
        "node": { "$ref": "parts/node.json" },
        "session": { "type": "string" },
        "expiry": { "type": "number" }
      },
      "required": ["interlock", "kind", "node", "session", "expiry"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "lease-expired" },
        "node": { "$ref": "parts/node.json" },
        "session": { "type": "string" }
      },
      "required": ["interlock", "kind", "node", "session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "session-started" },
        "session": { "$ref": "parts/session.json" },
        "brief": { "$ref": "parts/session-brief.json" },
        "graphBaseSha": { "type": "string" }
      },
      "required": ["interlock", "kind", "session", "brief"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "note-appended" },
        "session": { "type": "string" },
        "note": { "$ref": "parts/note.json" }
      },
      "required": ["interlock", "kind", "session", "note"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "gate-moved" },
        "node": { "$ref": "parts/node.json" },
        "gate": { "type": "string" },
        "to": { "$ref": "parts/gate-v1.json" }
      },
      "required": ["interlock", "kind", "node", "gate", "to"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "receipt-written" },
        "node": { "$ref": "parts/node.json" },
        "receipt": { "$ref": "parts/receipt-v1.json" }
      },
      "required": ["interlock", "kind", "node", "receipt"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "outcome-set" },
        "node": { "$ref": "parts/node.json" },
        "outcome": { "$ref": "parts/outcome-v1.json" }
      },
      "required": ["interlock", "kind", "node", "outcome"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "interlock": { "const": "event@v1" },
        "kind": { "const": "outbox-intent-recorded" },
        "node": { "$ref": "parts/node.json" },
        "id": { "type": "string" },
        "intent": { "type": "string" }
      },
      "required": ["interlock", "kind", "node", "id", "intent"],
      "additionalProperties": false
    }
  ]
}
