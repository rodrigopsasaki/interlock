{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/event@v9.json",
  "title": "event@v9",
  "description": "One journal line at the current shape. Additive over event@v8: person-said records a person's words put into a live session's pane, persisted before the words are delivered, with its outbox identity; its delivery is recorded by outbox-delivery-recorded under that identity, as acknowledged or uncertain. No older version may carry person-said, and every older line upcasts unchanged. Carried from event@v8: note-appended may carry a question note. Carried from event@v7: session-started may carry the walk its brief was given, debrief-filed may carry the verifier's mark counts, and a session may carry an observed session-facts record.",
  "type": "object",
  "properties": {
    "interlock": { "const": "event@v9" },
    "kind": {
      "enum": ["node-created", "lease-taken", "lease-renewed", "lease-expired", "session-started", "note-appended", "debrief-filed", "gate-moved", "receipt-written", "outcome-set", "outbox-intent-recorded", "outbox-delivery-recorded", "session-narrated", "session-facts-observed", "person-said"]
    }
  },
  "required": ["interlock", "kind"],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "session-started" } } },
      "then": {
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "node": { "$ref": "parts/node.json" },
              "runtime": { "$ref": "parts/session-runtime.json" }
            },
            "required": ["id", "node", "runtime"],
            "additionalProperties": false
          },
          "walk": {
            "description": "Carried from event@v7: present when the node's graph named a role, the walk its brief was given.",
            "$ref": "parts/walk.json"
          }
        },
        "required": ["session"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "note-appended" } } },
      "then": {
        "properties": {
          "session": { "type": "string" },
          "note": {
            "oneOf": [{ "$ref": "parts/note.json" }, { "$ref": "parts/question-note.json" }]
          }
        },
        "required": ["session", "note"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "debrief-filed" } } },
      "then": {
        "properties": {
          "markCounts": {
            "description": "Carried from event@v7: the verifier's marks on the filed debrief's claims, counted by mark, when the runner could verify it.",
            "$ref": "parts/mark-counts.json"
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "session-facts-observed" } } },
      "then": {
        "properties": {
          "session": { "type": "string" },
          "facts": { "$ref": "parts/session-facts.json" }
        },
        "required": ["session", "facts"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "person-said" } } },
      "then": {
        "properties": {
          "session": { "type": "string" },
          "said": { "$ref": "parts/person-said.json" }
        },
        "required": ["session", "said"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "outbox-intent-recorded" } } },
      "then": {
        "properties": { "node": { "$ref": "parts/node.json" }, "effect": { "$ref": "parts/outbox-intent.json" } },
        "required": ["node", "effect"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "outbox-delivery-recorded" } } },
      "then": {
        "properties": {
          "delivery": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "state": { "enum": ["acknowledged", "uncertain"] },
              "because": { "type": "string" },
              "derivation": { "$ref": "parts/derivation.json" },
              "acknowledgment": { "$ref": "parts/outbox-artifact.json" }
            },
            "required": ["id", "state", "because", "derivation"],
            "allOf": [
              {
                "if": { "properties": { "state": { "const": "acknowledged" } } },
                "then": {
                  "properties": {
                    "acknowledgment": { "$ref": "parts/outbox-artifact.json" }
                  },
                  "required": ["acknowledgment"]
                },
                "else": { "not": { "required": ["acknowledgment"] } }
              }
            ],
            "additionalProperties": false
          }
        },
        "required": ["delivery"]
      }
    }
  ]
}
