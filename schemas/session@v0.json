{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/session@v0.json",
  "title": "session@v0",
  "type": "object",
  "required": ["interlock", "id", "phase", "phaseId", "parentId", "kind", "graph", "node", "lens", "subjectHash", "snapshotHash", "arc", "runtime", "model", "pid", "pgid", "runnerPid", "runnerBirth", "runnerBoot", "launchNonce", "controlSecret", "startedAt", "endedAt", "state", "exitCode", "signal", "reason", "reaped", "captureComplete", "asks", "waitingOnAsk", "transcriptPath", "sampledMembers", "goIntent"],
  "properties": {
    "interlock": {"const": "session@v0"},
    "id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["work", "debrief", "review"]},
    "phaseId": {"type": "string", "minLength": 1},
    "parentId": {"type": ["string", "null"]},
    "kind": {"enum": ["node", "review"]},
    "graph": {"type": "string"},
    "node": {"type": ["string", "null"]},
    "lens": {"type": ["string", "null"]},
    "subjectHash": {"type": ["string", "null"]},
    "snapshotHash": {"type": ["string", "null"]},
    "arc": {"type": ["string", "null"]},
    "runtime": {"type": "string"},
    "model": {"type": "string"},
    "pid": {"type": ["integer", "null"]},
    "pgid": {"type": ["integer", "null"]},
    "runnerPid": {"type": "integer"},
    "runnerBirth": {"type": "string"},
    "runnerBoot": {"type": "string"},
    "launchNonce": {"type": "string"},
    "controlSecret": {"type": "string"},
    "startedAt": {"type": "string"},
    "endedAt": {"type": ["string", "null"]},
    "state": {"enum": ["running", "done", "failed", "killed"]},
    "exitCode": {"type": ["integer", "null"]},
    "signal": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "reaped": {"type": "integer", "minimum": 0},
    "captureComplete": {"type": "boolean"},
    "asks": {"type": "array"},
    "waitingOnAsk": {"type": "boolean"},
    "transcriptPath": {"type": "string"},
    "sampledMembers": {"type": "array", "items": {"type": "integer"}},
    "goIntent": {"type": "boolean"}
  },
  "additionalProperties": false
}
