{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/runtimes@v2.json",
  "title": "runtimes@v2",
  "description": "Adds optional account provider, routable, exec writable roots, exclusive MCP and named environment forwarding to the published commits mode. v0 and v1 remain readable; catalogue-specific combinations are checked by the loader.",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "runtimes@v2"
    },
    "runtimes": {
      "type": "object",
      "description": "Each entry accepts optional writable_root_args, mcp_exclusive, environment_passthrough and environment_forward_args fields for exec preparation.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string"
          },
          "startup_answers": {
            "type": "array",
            "items": {
              "$ref": "parts/startup-answer.json"
            }
          },
          "startup_timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "prompt_taken_timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "ready_settle_ms": {
            "type": "integer",
            "minimum": 0
          },
          "prompt_retries": {
            "type": "integer",
            "minimum": 0
          },
          "writable_root_args": {
            "$ref": "parts/writable-root-args.json"
          },
          "exec": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "contains": {
              "const": "{command}"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "read_only_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcp_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mcp_allow": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mcp_disable_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "contains": {
              "const": "{name}"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "mcp_exclusive": {
            "type": "object",
            "properties": {
              "disable_all": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "allow_each": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "contains": {
                  "const": "{name}"
                },
                "minContains": 1,
                "maxContains": 1
              }
            },
            "required": [
              "disable_all",
              "allow_each"
            ],
            "additionalProperties": false
          },
          "environment_passthrough": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "not": {
                "enum": [
                  "INTERLOCK_SESSION",
                  "INTERLOCK_GRAPH",
                  "INTERLOCK_NODE"
                ]
              }
            },
            "uniqueItems": true
          },
          "environment_forward_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "contains": {
              "const": "{name}"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "prompt": {
            "const": "stdin"
          },
          "commits": {
            "enum": [
              "runner",
              "agent"
            ],
            "default": "agent",
            "description": "Who commits attempt changes. Runner mode keeps signing outside the agent sandbox and commits code before the debrief."
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "routable": {
            "const": true
          }
        },
        "required": [
          "kind",
          "model"
        ],
        "additionalProperties": true,
        "not": {
          "properties": {
            "mcp_exclusive": {},
            "mcp_disable_args": {}
          },
          "required": [
            "mcp_exclusive",
            "mcp_disable_args"
          ]
        },
        "dependentRequired": {
          "routable": [
            "provider"
          ]
        }
      }
    }
  },
  "required": [
    "interlock"
  ],
  "additionalProperties": true
}
