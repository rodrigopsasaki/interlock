{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/machine@v0.json",
  "title": "machine@v0",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "machine@v0"
    },
    "provider": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "properties": {
            "admit": {
              "$ref": "#/$defs/argv"
            },
            "release": {
              "$ref": "#/$defs/argv"
            },
            "env": {
              "$ref": "#/$defs/argv"
            },
            "heavy": {
              "$ref": "#/$defs/argv"
            }
          },
          "required": [
            "admit",
            "release",
            "env",
            "heavy"
          ]
        }
      ],
      "description": "Capacity coordination must be explicitly configured or explicitly disabled; a missing file never opts out."
    }
  },
  "required": [
    "interlock",
    "provider"
  ],
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      },
      "contains": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
