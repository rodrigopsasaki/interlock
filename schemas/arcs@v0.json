{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/arcs@v0.json",
  "title": "arcs@v0",
  "description": "The owner's asks, each as an arc in his own words, with the graphs the planner derived to satisfy it. A graph whose ask is not found in his words is listed under needs_his_words, never given an invented one.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interlock": {
      "const": "arcs@v0"
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "$ref": "#/$defs/line"
          },
          "ask": {
            "$ref": "#/$defs/line"
          },
          "source": {
            "$ref": "#/$defs/line"
          },
          "graphs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/line"
            }
          }
        },
        "required": [
          "id",
          "title",
          "ask",
          "source",
          "graphs"
        ]
      }
    },
    "needs_his_words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "graph": {
            "$ref": "#/$defs/line"
          },
          "found": {
            "$ref": "#/$defs/line"
          }
        },
        "required": [
          "graph",
          "found"
        ]
      }
    }
  },
  "required": [
    "interlock",
    "arcs"
  ],
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
    }
  }
}
