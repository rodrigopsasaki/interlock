{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/commits@v0.json",
  "title": "commits@v0",
  "description": "Ordered code commits requested by an agent for runner custody. Duplicate paths, unchanged paths, reserved session artifacts and a missing fallback for changed remainder paths are runner checks. Session artifacts are committed after the code HEAD is available to debrief prepare.",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "commits@v0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/$defs/message"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/|[A-Za-z]:[\\\\/])(?!.*[\\\\\\u0000*?\\[\\]{}])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
            }
          }
        },
        "required": [
          "message",
          "paths"
        ]
      }
    },
    "fallback_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
    },
    "co_authored_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
    }
  },
  "required": [
    "interlock",
    "entries"
  ],
  "$defs": {
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[^\\n]*\\S)[^\\n\\u0000]{1,100}(?:\\n[^\\u0000]*)?$"
    }
  }
}
