{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/event@v11.json",
  "title": "event@v11",
  "description": "Adds durable runtime probe events while retaining every earlier event version.",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "event@v11"
    },
    "kind": {
      "enum": [
        "node-created",
        "lease-taken",
        "lease-renewed",
        "lease-expired",
        "session-started",
        "note-appended",
        "debrief-filed",
        "gate-moved",
        "receipt-written",
        "outcome-set",
        "outbox-intent-recorded",
        "outbox-delivery-recorded",
        "session-narrated",
        "session-facts-observed",
        "person-said",
        "receipt-retracted",
        "probe"
      ]
    },
    "probeId": { "type": "string" },
    "profile": { "type": "string" },
    "configuration": { "type": "string" },
    "implementationVersion": { "type": "string" },
    "checks": { "type": "array" },
    "signedCommitKeyFingerprint": { "type": "string" },
    "derivation": { "$ref": "parts/derivation.json" },
    "at": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "interlock",
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session-started"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "node": {
                "$ref": "parts/node.json"
              },
              "runtime": {
                "$ref": "parts/session-runtime-v1.json"
              }
            },
            "required": [
              "id",
              "node",
              "runtime"
            ],
            "additionalProperties": false
          },
          "walk": {
            "description": "Carried from event@v7: present when the node's graph named a role, the walk its brief was given.",
            "$ref": "parts/walk.json"
          },
          "startedAt": {
            "description": "Additive within event@v9: the runner clock's epoch-millisecond wall time when it appended this event. Absent on historical and backfilled sessions, whose start reads unknown; never inferred from a lease, narration or a file time.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "session"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "note-appended"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "string"
          },
          "note": {
            "oneOf": [
              {
                "$ref": "parts/note.json"
              },
              {
                "$ref": "parts/question-note.json"
              }
            ]
          }
        },
        "required": [
          "session",
          "note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "debrief-filed"
          }
        }
      },
      "then": {
        "properties": {
          "markCounts": {
            "description": "Carried from event@v7: the verifier's marks on the filed debrief's claims, counted by mark, when the runner could verify it.",
            "$ref": "parts/mark-counts.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session-facts-observed"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "string"
          },
          "facts": {
            "$ref": "parts/session-facts.json"
          }
        },
        "required": [
          "session",
          "facts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "person-said"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "string"
          },
          "said": {
            "$ref": "parts/person-said.json"
          }
        },
        "required": [
          "session",
          "said"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "receipt-retracted"
          }
        }
      },
      "then": {
        "properties": {
          "node": { "$ref": "parts/node.json" },
          "gate": { "type": "string" },
          "receiptId": { "type": "string" },
          "by": { "type": "string" },
          "because": { "type": "string" }
        },
        "required": ["node", "gate", "receiptId", "by", "because"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "outbox-intent-recorded"
          }
        }
      },
      "then": {
        "properties": {
          "node": {
            "$ref": "parts/node.json"
          },
          "effect": {
            "$ref": "parts/outbox-intent.json"
          }
        },
        "required": [
          "node",
          "effect"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "outbox-delivery-recorded"
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "enum": [
                  "acknowledged",
                  "uncertain"
                ]
              },
              "because": {
                "type": "string"
              },
              "derivation": {
                "$ref": "parts/derivation.json"
              },
              "acknowledgment": {
                "$ref": "parts/outbox-artifact.json"
              }
            },
            "required": [
              "id",
              "state",
              "because",
              "derivation"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "acknowledged"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "acknowledgment": {
                      "$ref": "parts/outbox-artifact.json"
                    }
                  },
                  "required": [
                    "acknowledgment"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "acknowledgment"
                    ]
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "delivery"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "probe"
          }
        }
      },
      "then": {
        "properties": {
          "probeId": { "type": "string" },
          "profile": { "type": "string" },
          "configuration": { "type": "string" },
          "implementationVersion": { "type": "string" },
          "checks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["check", "state"],
                  "properties": {
                    "check": { "type": "string" },
                    "state": { "const": "passed" },
                    "fingerprint": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "required": ["check", "state", "error"],
                  "properties": {
                    "check": { "type": "string" },
                    "state": { "const": "refused" },
                    "error": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "required": ["check", "state", "reason"],
                  "properties": {
                    "check": { "type": "string" },
                    "state": { "const": "unavailable" },
                    "reason": { "type": "string" }
                  }
                }
              ]
            }
          },
          "derivation": { "$ref": "parts/derivation.json" },
          "at": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "probeId",
          "profile",
          "configuration",
          "implementationVersion",
          "checks",
          "derivation",
          "at"
        ]
      }
    }
  ]
}
