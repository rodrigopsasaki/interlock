{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigopsasaki/interlock/schemas/machine@v1.json",
  "title": "machine@v1",
  "type": "object",
  "properties": {
    "interlock": {
      "const": "machine@v1"
    },
    "provider": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "properties": {
            "admit": {
              "$ref": "#/$defs/argv"
            },
            "release": {
              "$ref": "#/$defs/argv"
            },
            "env": {
              "$ref": "#/$defs/argv"
            },
            "heavy": {
              "$ref": "#/$defs/argv"
            },
            "cite": {
              "$ref": "#/$defs/argv"
            },
            "busy": {
              "$ref": "#/$defs/busy"
            }
          },
          "required": [
            "admit",
            "release",
            "env",
            "heavy"
          ]
        }
      ],
      "description": "Capacity coordination must be explicitly configured or explicitly disabled; a missing file never opts out."
    }
  },
  "required": [
    "interlock",
    "provider"
  ],
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      },
      "contains": {
        "type": "string",
        "minLength": 1
      }
    },
    "busy": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 64,
          "maximum": 113
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "first_backoff_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_backoff_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "required": [
        "exit_code",
        "attempts",
        "first_backoff_ms",
        "max_backoff_ms"
      ]
    }
  }
}
